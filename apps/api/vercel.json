{
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.9.0"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.php"
    }
  ],
  "outputDirectory": null,
  "installCommand": "composer install --no-dev --optimize-autoloader",
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false"
  }
}
